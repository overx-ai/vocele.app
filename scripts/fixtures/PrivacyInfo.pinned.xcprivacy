<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Pinned copy of ios-claude-hello/Template/PrivacyInfo.xcprivacy (tracking + collected data types only). /privacy is
  checked against it, and scripts/check-legal.mjs fails when the app's manifest says anything else (LEGAL_SIBLING=skip
  where the app is not checked out). Equal to the app at ios-claude-hello df9f98a (spec 251). Re-copy when the
  manifest changes.
-->
