---
import { VS_PAGES } from '../vs-pages';
import { GA_MEASUREMENT_ID, OPERATOR } from '../data/facts';
import { CONSENT_COPY } from './consent-copy';
export interface Props { lang?: 'en' | 'es' }
const { lang = 'en' } = Astro.props;
const base = lang === 'es' ? '/es' : '';
const t = lang === 'es'
  ? { pricing: 'Precios', faq: 'Preguntas', blog: 'Artículos', fairUse: 'Uso justo', privacy: 'Privacidad', terms: 'Términos' }
  : { pricing: 'Pricing', faq: 'FAQ', blog: 'Blog', fairUse: 'Fair use', privacy: 'Privacy', terms: 'Terms' };

const links = [
  { href: `${base}/pricing`, label: t.pricing },
  { href: `${base}/faq`, label: t.faq },
  { href: `${base}/blog`, label: t.blog },
  // EN-only comparison pages (src/vs-pages.ts); ES has no twins yet.
  ...VS_PAGES.map((v) => ({ href: `/vs/${v.slug}`, label: `vs ${v.competitor}` })),
  // Fair use has an /es twin (it is a purchase-decision disclosure); privacy/terms are EN-only.
  { href: `${base}/fair-use`, label: t.fairUse },
  { href: '/privacy', label: t.privacy },   // EN-only legal pages
  { href: '/terms', label: t.terms },
];
const year = new Date().getFullYear();
const cookieSettings = CONSENT_COPY[lang].settings;
---

<footer class="site-footer">
  <div class="container row">
    <span class="brand">Vocele</span>
    <nav aria-label="Footer">
      <ul>
        {links.map((l) => (
          <li><a href={l.href}>{l.label}</a></li>
        ))}
        {GA_MEASUREMENT_ID && <li><button type="button" data-consent-open>{cookieSettings}</button></li>}
      </ul>
    </nav>
    <p class="copy">&copy; {year} {OPERATOR}</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-ink);
    color: var(--color-ink-soft);
    border-top: 1px solid rgba(84, 84, 88, 0.6);
    padding: var(--space-xl) 0;
  }
  .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    flex-wrap: wrap;
  }
  .brand {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.0625rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: #f5f5f7;
  }
  nav ul {
    display: flex;
    gap: var(--space-lg);
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  nav a { text-decoration: none; color: var(--color-ink-soft); }
  nav button { padding: 0; border: 0; background: none; color: var(--color-ink-soft); font: inherit; letter-spacing: inherit; text-transform: inherit; cursor: pointer; }
  nav a:hover, nav button:hover { color: #f5f5f7; }
  .copy { margin: 0; font-size: 0.8125rem; }

  @media (max-width: 640px) {
    .row { flex-direction: column; align-items: flex-start; gap: var(--space-md); }
  }
</style>
