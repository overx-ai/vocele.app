---
import { VS_PAGES } from '../vs-pages';
import { GA_MEASUREMENT_ID, OPERATOR } from '../data/facts';
import { useLang } from '../i18n';
import { localePath } from '../site-pages';
import type { Lang } from '../data/types';
export interface Props { lang: Lang }
const { lang } = Astro.props;
const { t } = useLang(lang);

const links = [
  { href: localePath(lang, 'pricing'), label: t.nav.pricing },
  { href: localePath(lang, 'faq'), label: t.nav.faq },
  { href: localePath(lang, 'blog'), label: t.nav.blog },
  ...VS_PAGES.map((v) => ({ href: `/vs/${v.slug}`, label: `vs ${v.competitor}` })), // English-only (src/vs-pages.ts)
  { href: localePath(lang, 'fair-use'), label: t.nav.fairUse },
  { href: '/privacy', label: t.nav.privacy }, // English-only legal pages
  { href: '/terms', label: t.nav.terms },
];
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container row">
    <span class="brand">Vocele</span>
    <nav aria-label={t.nav.footerLabel}>
      <ul>
        {links.map((l) => (
          <li><a href={l.href}>{l.label}</a></li>
        ))}
        {GA_MEASUREMENT_ID && <li><button type="button" data-consent-open>{t.consent.settings}</button></li>}
      </ul>
    </nav>
    <p class="copy">&copy; {year} {OPERATOR}</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-ink);
    color: var(--color-ink-soft);
    border-top: 1px solid rgba(84, 84, 88, 0.6);
    padding: var(--space-xl) 0;
  }
  .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    flex-wrap: wrap;
  }
  .brand {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.0625rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: #f5f5f7;
  }
  nav ul {
    display: flex;
    gap: var(--space-lg);
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  nav a { text-decoration: none; color: var(--color-ink-soft); }
  nav button { padding: 0; border: 0; background: none; color: var(--color-ink-soft); font: inherit; letter-spacing: inherit; text-transform: inherit; cursor: pointer; }
  nav a:hover, nav button:hover { color: #f5f5f7; }
  .copy { margin: 0; font-size: 0.8125rem; }

  @media (max-width: 640px) {
    .row { flex-direction: column; align-items: flex-start; gap: var(--space-md); }
  }
</style>
