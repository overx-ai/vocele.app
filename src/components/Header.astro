---
import { enPath, esPath } from '../site-pages';

export interface Props {
  lang?: 'en' | 'es';
  /** Current page's shared slug — makes the language switcher keep your place. */
  slug?: string;
  /** Whether an /es twin of this page exists (computed in BaseLayout). */
  translated?: boolean;
}
const { lang = 'en', slug = '', translated = false } = Astro.props;
const base = lang === 'es' ? '/es' : '';
const home = lang === 'es' ? '/es' : '/'; // never '/es/' — trailing slash 301s

// blog articles share the 'blog' nav highlight; everything else matches its slug.
const activeKey = slug.startsWith('blog') ? 'blog' : slug;

const nav = lang === 'es'
  ? [
      { key: '', href: home, label: 'Inicio' },
      { key: 'pricing', href: `${base}/pricing`, label: 'Precios' },
      { key: 'faq', href: `${base}/faq`, label: 'Preguntas' },
      { key: 'blog', href: `${base}/blog`, label: 'Artículos' },
    ]
  : [
      { key: '', href: home, label: 'Home' },
      { key: 'pricing', href: `${base}/pricing`, label: 'Pricing' },
      { key: 'faq', href: `${base}/faq`, label: 'FAQ' },
      { key: 'blog', href: `${base}/blog`, label: 'Blog' },
    ];

// Slug-aware switch when the twin exists; otherwise fall back to the other
// locale's home (privacy/terms/404 have no /es twin — never link a 404).
const otherLangHref = translated
  ? (lang === 'es' ? enPath(slug) : esPath(slug))
  : (lang === 'es' ? '/' : '/es');
const otherLangLabel = lang === 'es' ? 'EN' : 'ES';

// The #download target only exists on the home pages — anchor via the locale home.
const ctaHref = lang === 'es' ? '/es#download' : '/#download';
---

<header class="site-header">
  <div class="container bar">
    <a href={home} class="logo" aria-label="Vocele home">
      <!--
        The real app icon, not a drawing of one. This was an inline pink-gradient SVG (a rounded
        square with a smile arc) that predated the icon and matched nothing the learner installs.
        The shipping icon is a photoreal iridescent chrome blob on a near-black field, so there is
        no honest SVG of it — same reason favicon.svg was retired in BaseLayout.

        96px for a 30px slot: covers 3× displays exactly (30 × 3 = 90) at 18 KB, where reusing
        icon-192.png would ship 53 KB on every page for the same 30 pixels.

        `border-radius` is the iOS mask, 22.4% of the side — what the icon actually looks like on a
        home screen. The old mark used 32%, which was the site's own shape language rather than the
        product's.
      -->
      <img src="/logo-96.png" width="30" height="30" alt="" class="logo-mark" />
      <span>Vocele</span>
    </a>

    <nav class="main-nav" aria-label="Primary">
      <ul>
        {nav.map((item) => (
          <li><a href={item.href} class={item.key === activeKey ? 'active' : ''}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      <a href={otherLangHref} class="lang-switch" aria-label="Switch language">{otherLangLabel}</a>
      <a href={ctaHref} class="cta">{lang === 'es' ? 'Descargar' : 'Get the App'} <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: var(--border-bold);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    height: 68px;
  }
  .logo-mark {
    display: block;
    /* 22.4% — the iOS icon mask, so the nav mark reads as the thing you install. */
    border-radius: 22.4%;
    flex: none;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 9px;
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.3125rem;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: var(--color-ink);
  }
  .main-nav ul {
    display: flex;
    gap: 28px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .main-nav a {
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }
  .main-nav a.active { color: var(--color-ink); }
  .main-nav a:hover { color: var(--grad-talk-to); }
  .header-actions { display: flex; align-items: center; gap: var(--space-compact); }
  .lang-switch {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.8125rem;
    text-decoration: none;
    color: var(--color-ink);
    border: var(--border-bold);
    border-radius: var(--radius-pill);
    padding: 6px 12px;
  }
  .lang-switch:hover { background: var(--color-ink); color: #fff; }
  .cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 10px 22px;
    border-radius: var(--radius-pill);
    text-decoration: none;
    background: var(--color-ink);
    color: #fff;
    transition: background 0.15s ease;
    white-space: nowrap;
  }
  .cta:hover { background: var(--grad-talk-to); color: #fff; }

  @media (max-width: 760px) {
    .main-nav { display: none; }
    .bar { height: 60px; }
    .cta { padding: 9px 16px; }
  }
</style>
