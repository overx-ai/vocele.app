---
import { useLang } from '../i18n';
import { liveLocales } from '../i18n/locales';
import { downloadPath, localePath, switchPath } from '../site-pages';
import type { Lang } from '../data/types';

export interface Props {
  lang: Lang;
  /** Current page's shared slug — makes the language menu keep your place. */
  slug: string;
}
const { lang, slug } = Astro.props;
const { t } = useLang(lang);
const home = localePath(lang, '');

// blog articles share the 'blog' nav highlight; everything else matches its slug.
const activeSlug = slug.startsWith('blog') ? 'blog' : slug;

const nav = [
  { slug: '', label: t.nav.home },
  { slug: 'pricing', label: t.nav.pricing },
  { slug: 'faq', label: t.nav.faq },
  { slug: 'blog', label: t.nav.blog },
];
---

<header class="site-header">
  <div class="container bar">
    <a href={home} class="logo" aria-label={t.nav.logoLabel}>
      <!--
        The real app icon, not a drawing of one. This was an inline pink-gradient SVG (a rounded
        square with a smile arc) that predated the icon and matched nothing the learner installs.
        The shipping icon is a photoreal iridescent chrome blob on a near-black field, so there is
        no honest SVG of it — same reason favicon.svg was retired in BaseLayout.

        96px for a 30px slot: covers 3× displays exactly (30 × 3 = 90) at 18 KB, where reusing
        icon-192.png would ship 53 KB on every page for the same 30 pixels.

        `border-radius` is the iOS mask, 22.4% of the side — what the icon actually looks like on a
        home screen. The old mark used 32%, which was the site's own shape language rather than the
        product's.
      -->
      <img src="/logo-96.png" width="30" height="30" alt="" class="logo-mark" />
      <span>Vocele</span>
    </a>

    <nav class="main-nav" aria-label={t.nav.primaryLabel}>
      <ul>
        {nav.map((item) => (
          <li><a href={localePath(lang, item.slug)} class={item.slug === activeSlug ? 'active' : ''}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      <details class="lang-menu">
        <summary aria-label={t.nav.switchLanguage}>{lang.toUpperCase()}</summary>
        <ul>
          {liveLocales().map((l) => (
            <li>
              <a href={switchPath(l.code, slug)} lang={l.tag} hreflang={l.hreflang} aria-current={l.code === lang ? 'true' : undefined}>{l.name}</a>
            </li>
          ))}
        </ul>
      </details>
      <a href={downloadPath(lang)} class="cta">{t.nav.getApp} <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: var(--border-bold);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    height: 68px;
  }
  .logo-mark {
    display: block;
    /* 22.4% — the iOS icon mask, so the nav mark reads as the thing you install. */
    border-radius: 22.4%;
    flex: none;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 9px;
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.3125rem;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: var(--color-ink);
  }
  .main-nav ul {
    display: flex;
    gap: 28px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .main-nav a {
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }
  .main-nav a.active { color: var(--color-ink); }
  .main-nav a:hover { color: var(--grad-talk-to); }
  .header-actions { display: flex; align-items: center; gap: var(--space-compact); }
  .lang-menu { position: relative; }
  .lang-menu summary {
    display: flex;
    align-items: center;
    gap: 5px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.8125rem;
    color: var(--color-ink);
    border: var(--border-bold);
    border-radius: var(--radius-pill);
    padding: 6px 12px;
    cursor: pointer;
    list-style: none;
  }
  .lang-menu summary::-webkit-details-marker { display: none; }
  .lang-menu summary::after { content: '▾'; font-size: 0.625rem; }
  .lang-menu summary:hover, .lang-menu[open] summary { background: var(--color-ink); color: #fff; }
  /* The list sits on the page's end edge, so at 390px it can only grow towards the free side of the header. */
  .lang-menu ul {
    position: absolute;
    top: calc(100% + 8px);
    inset-inline-end: 0;
    min-width: 168px;
    max-height: calc(100vh - 84px);
    overflow-y: auto;
    list-style: none;
    margin: 0;
    padding: 6px;
    background: #fff;
    border: var(--border-bold);
    box-shadow: calc(4px * var(--flip)) 4px 0 var(--color-ink);
    /* Never the page's own --font-body: Japanese fonts set Cyrillic and Latin full-width. */
    font-family: var(--font-system);
    font-size: 0.9375rem;
  }
  .lang-menu li a { display: block; padding: 9px 12px; text-decoration: none; color: var(--color-ink); }
  .lang-menu li a:hover { background: var(--color-bg-secondary); }
  .lang-menu li a[aria-current] { font-weight: 700; }
  .cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 10px 22px;
    border-radius: var(--radius-pill);
    text-decoration: none;
    background: var(--color-ink);
    color: #fff;
    transition: background 0.15s ease;
    white-space: nowrap;
  }
  .cta:hover { background: var(--grad-talk-to); color: #fff; }

  @media (max-width: 760px) {
    .main-nav { display: none; }
    .bar { height: 60px; }
    .cta { padding: 9px 16px; }
  }
</style>
