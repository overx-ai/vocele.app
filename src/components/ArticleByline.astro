---
import { useLang } from '../i18n';
import { AUTHOR } from '../site';
import { localePath } from '../site-pages';
import type { Lang } from '../data/types';

export interface Props {
  lang: Lang;
  datePublished: string;
  dateModified?: string;
}

const { lang, datePublished, dateModified } = Astro.props;
const { t, fmt } = useLang(lang);
const date = (iso: string) => fmt.date(iso, { year: 'numeric', month: 'long', day: 'numeric' });
const modified = dateModified && dateModified !== datePublished ? dateModified : undefined;
const [founderBefore, founderAfter] = t.article.founderOf;
---
<p class="byline">
  <span class="byline-brand">
    <!-- The byline's copy of the header mark — same asset, same iOS mask. See Header.astro. -->
    <img src="/logo-96.png" width="20" height="20" alt="" class="byline-mark" />
    {AUTHOR.name}, {founderBefore}<a href={localePath(lang, '')} rel="author">Vocele</a>{founderAfter}
  </span>
  <span class="sep" aria-hidden="true">·</span>
  <time datetime={datePublished}>{date(datePublished)}</time>
  {modified && (
    <>
      <span class="sep" aria-hidden="true">·</span>
      <span>{t.article.updated} <time datetime={modified}>{date(modified)}</time></span>
    </>
  )}
</p>
