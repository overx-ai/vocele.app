---
import { GA_MEASUREMENT_ID } from '../data/facts';
import { CONSENT_COPY } from './consent-copy';
import type { Lang } from '../data/types';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = CONSENT_COPY[lang];
---
{GA_MEASUREMENT_ID && (
  <div id="consent" class="consent" role="region" aria-label={t.label} hidden>
    <p>
      {t.text}{' '}
      <a href="/privacy#website" hreflang={lang === 'es' ? 'en' : undefined}>{t.privacy}</a>
    </p>
    <div class="choices">
      <button type="button" data-consent="granted">{t.accept}</button>
      <button type="button" data-consent="denied">{t.reject}</button>
    </div>
  </div>
)}

<script>
  import '../scripts/consent';
</script>

<style>
  .consent {
    position: fixed;
    z-index: 20;
    inset-inline: var(--space-sm);
    bottom: var(--space-sm);
    max-width: 560px;
    margin-inline: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm) var(--space-md);
    padding: 12px var(--space-md);
    background: var(--color-bg);
    color: var(--color-ink);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-large);
    box-shadow: var(--shadow-card-lg);
    font-size: 14px;
    line-height: 1.45;
  }
  .consent[hidden] { display: none; }
  .consent p { flex: 1 1 260px; margin: 0; }
  .consent a { white-space: nowrap; color: var(--color-ink); }
  .choices { display: flex; gap: var(--space-sm); flex: 1 0 auto; }
  .choices button {
    flex: 1 1 0;
    min-height: 44px;
    padding: 10px 20px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-bg-secondary);
    color: var(--color-ink);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }
  .choices button:hover { border-color: var(--color-text-secondary); }
</style>
