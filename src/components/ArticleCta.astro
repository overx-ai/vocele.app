---
export interface Props {
  lang: 'en' | 'es';
}

const { lang } = Astro.props;
const es = lang === 'es';
---
<section class="art-cta">
  <div class="container cta-inner">
    <h2>{es ? 'Muy pronto en iPhone: tu ' : 'Coming soon to iPhone: your '}<span class="clip-talk">{es ? 'coach de IA.' : 'AI coach.'}</span></h2>
    <p>
      {es
        ? 'Vocele todavía no está en la App Store. Cuando se lance, corregirá tu inglés hablado y entrenará tu acento, palabra por palabra.'
        : "Vocele isn't on the App Store yet. When it launches, it will correct your spoken sentences and train your accent, word by word."}
    </p>
    <a href={es ? '/es' : '/'} class="pill pill-light">{es ? 'Conoce Vocele' : 'Meet Vocele'} <span aria-hidden="true">↗</span></a>
  </div>
</section>
