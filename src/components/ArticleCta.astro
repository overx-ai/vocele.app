---
import Clip from './Clip.astro';
import { useLang } from '../i18n';
import { localePath } from '../site-pages';
import type { Lang } from '../data/types';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { t } = useLang(lang);
---
<section class="art-cta">
  <div class="container cta-inner">
    <h2><Clip parts={t.article.ctaTitle} class="clip-talk" /></h2>
    <p>{t.article.ctaBody}</p>
    <a href={localePath(lang, '')} class="pill pill-light">{t.meetVocele} <span aria-hidden="true">↗</span></a>
  </div>
</section>
