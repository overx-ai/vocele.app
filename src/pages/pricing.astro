---
import BaseLayout from '../layouts/BaseLayout.astro';
import PricingCard from '../components/PricingCard.astro';
import { SOFTWARE_APP } from '../site';

const structuredData = [
  { '@context': 'https://schema.org', ...SOFTWARE_APP },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://vocele.app/' },
      { '@type': 'ListItem', position: 2, name: 'Pricing', item: 'https://vocele.app/pricing' },
    ],
  },
];
---
<BaseLayout
  title="Pricing"
  description="Vocele pricing: Core $14.99/mo, Fluency $29.99/mo, and Meta $49.99/mo — an AI language coach priced against private tutoring ($200-320/mo), not against free apps."
  slug="pricing"
  structuredData={structuredData}
>
  <section class="masthead">
    <div class="container">
      <span class="eyebrow">Pricing</span>
      <h1 class="mast-title">Cheaper than a <span class="clip">tutor.</span> Built to actually work.</h1>
      <p class="lead">A private tutor twice a week runs $200–320/month. Vocele gives you daily practice, on your schedule, for a fraction of that — pick the depth you need.</p>
    </div>
  </section>

  <section class="triptych">
    <PricingCard
      variant="core"
      name="Core"
      price="$14.99"
      period="/ month"
      tagline="Never miss your daily practice."
      cta="Start with Core"
      features={[
        'Unlimited vocabulary training',
        'Daily conversation practice with Luna &amp; Lorenzo',
        'Streaks &amp; progress charts',
        'Standard voice playback',
      ]}
    />
    <PricingCard
      variant="fluency"
      badge="★ Most Popular"
      name="Fluency"
      price="$29.99"
      period="/ month"
      tagline="Prove to yourself you're improving."
      cta="Start with Fluency"
      features={[
        '<strong>Everything in Core</strong>',
        'Unlimited AI conversations, any mode',
        'Accent coaching with per-word scoring',
        'Personalized reading at your level',
        'Premium natural voices',
        'Adaptive learning plan',
      ]}
    />
    <PricingCard
      variant="meta"
      name="Meta"
      price="$49.99"
      period="/ month"
      tagline="Become who you came here to be."
      cta="Start with Meta"
      features={[
        '<strong>Everything in Fluency</strong>',
        'Weekly high-stakes simulations — job interviews, citizenship interviews, negotiations',
        'A 90-day roadmap built around your real goal',
        'Weekly progress reports',
        'Priority coach access',
      ]}
    />
  </section>
  <p class="billing-note">All plans billed monthly, cancel anytime · Annual plans available in the app at a discount</p>

  <section class="anchor">
    <div class="container">
      <h2 class="anchor-title">Why $49.99 still isn't the <span class="clip-talk">expensive</span> option</h2>
      <p class="anchor-links">Comparing AI coaches instead? <a href="/vs/praktika">Vocele vs Praktika</a> · <a href="/vs/fluently">Vocele vs Fluently</a></p>
      <div class="compare">
        <div class="compare-col">
          <p class="compare-label">Private tutor, 2×/week</p>
          <p class="compare-price muted">$200–320<span class="per">/mo</span></p>
          <p class="compare-copy">Scheduled, limited to your tutor's availability, no correction outside the lesson.</p>
        </div>
        <div class="compare-col vocele">
          <p class="compare-label pink">Vocele Meta</p>
          <p class="compare-price"><span class="clip-talk">$49.99</span><span class="per">/mo</span></p>
          <p class="compare-copy light">Daily practice, any time, plus a roadmap built around the one conversation that actually matters to you.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .masthead { padding: 84px 0 56px; border-bottom: var(--border-bold); }
  .mast-title { font-size: clamp(2.75rem, 7vw, 5.25rem); line-height: 0.98; margin: 0 0 var(--space-lg); max-width: 15ch; }
  .lead { color: var(--color-text-secondary); font-size: 1.1875rem; max-width: 56ch; margin: 0; }

  .triptych { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-bottom: var(--border-bold); }

  .billing-note {
    text-align: center; margin: 0; padding: 22px var(--space-lg);
    font-family: var(--font-display); font-weight: 600; font-size: 0.8125rem;
    letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--color-text-secondary); border-bottom: var(--border-bold);
  }

  .anchor { background: var(--color-ink); color: #f5f5f7; padding: 100px 0; }
  .anchor-title { font-size: clamp(2.25rem, 4.5vw, 3.625rem); line-height: 1.02; margin: 0 0 var(--space-2xl); max-width: 22ch; color: #f5f5f7; }
  .anchor-links { color: var(--color-ink-soft); margin: -28px 0 28px; font-size: 1rem; }
  .anchor-links a { color: #f5f5f7; border-bottom: 2px solid var(--grad-talk-to); text-decoration: none; }
  .compare { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border: 2px solid #f5f5f7; }
  .compare-col { padding: 44px 40px; }
  .compare-col:first-child { border-right: 2px solid #f5f5f7; }
  .compare-col.vocele { background: linear-gradient(160deg, rgba(245,125,158,0.14), rgba(240,69,130,0.08)); }
  .compare-label { font-family: var(--font-display); font-weight: 700; font-size: 0.875rem; letter-spacing: 0.1em; text-transform: uppercase; margin: 0 0 10px; color: var(--color-ink-soft); }
  .compare-label.pink { color: var(--grad-talk-from); }
  .compare-price { font-family: var(--font-display); font-weight: 800; font-size: clamp(2.375rem, 4vw, 3.625rem); line-height: 1; letter-spacing: -0.03em; margin: 0 0 16px; }
  .compare-price.muted { color: var(--color-ink-soft); }
  .compare-price .per { font-size: 1.0625rem; font-weight: 600; color: var(--color-ink-soft); }
  .compare-copy { font-size: 1rem; line-height: 1.6; margin: 0; color: var(--color-ink-soft); }
  .compare-copy.light { color: #d7d7db; }

  @media (max-width: 820px) {
    .triptych { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .masthead, .anchor { padding-left: 0; padding-right: 0; }
    .anchor { padding: 72px 0; }
    .compare { grid-template-columns: 1fr; }
    .compare-col:first-child { border-right: none; border-bottom: 2px solid #f5f5f7; }
  }
</style>
