---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PricingCard from '../../components/PricingCard.astro';
import { SOFTWARE_APP } from '../../site';

const structuredData = [
  { '@context': 'https://schema.org', ...SOFTWARE_APP },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://vocele.app/es' },
      { '@type': 'ListItem', position: 2, name: 'Precios', item: 'https://vocele.app/es/pricing' },
    ],
  },
];
---
<BaseLayout
  title="Precios"
  description="Precios de Vocele: Core $14.99/mes, Fluency $29.99/mes y Meta $49.99/mes — un coach de inglés con IA, mucho más económico que un maestro particular ($200-320/mes)."
  lang="es"
  slug="pricing"
  structuredData={structuredData}
>
  <section class="masthead">
    <div class="container">
      <span class="eyebrow">Precios</span>
      <h1 class="mast-title">Más barato que un <span class="clip">maestro.</span> Hecho para que sí funcione.</h1>
      <p class="lead">Un maestro particular dos veces por semana cuesta entre $200 y $320 al mes. Vocele te da práctica diaria, a tu horario, por una fracción de eso — elige la profundidad que necesitas.</p>
    </div>
  </section>

  <section class="triptych">
    <PricingCard
      variant="core"
      name="Core"
      price="$14.99"
      period="/ mes"
      tagline="Nunca faltes a tu práctica diaria."
      cta="Empezar con Core"
      ctaHref="/es#download"
      features={[
        'Entrenamiento de vocabulario ilimitado',
        'Práctica de conversación diaria con Luna y Lorenzo',
        'Rachas y gráficas de progreso',
        'Reproducción de voz estándar',
      ]}
    />
    <PricingCard
      variant="fluency"
      badge="★ Más Popular"
      name="Fluency"
      price="$29.99"
      period="/ mes"
      tagline="Compruébate a ti mismo que estás mejorando."
      cta="Empezar con Fluency"
      ctaHref="/es#download"
      features={[
        '<strong>Todo lo de Core</strong>',
        'Conversaciones con IA ilimitadas, en cualquier modo',
        'Entrenamiento de acento con puntaje por palabra',
        'Lecturas personalizadas a tu nivel',
        'Voces naturales premium',
        'Plan de aprendizaje adaptativo',
      ]}
    />
    <PricingCard
      variant="meta"
      name="Meta"
      price="$49.99"
      period="/ mes"
      tagline="Conviértete en quien viniste a ser."
      cta="Empezar con Meta"
      ctaHref="/es#download"
      features={[
        '<strong>Todo lo de Fluency</strong>',
        'Simulaciones semanales de alto nivel — entrevistas de trabajo, entrevista de ciudadanía, negociaciones',
        'Un plan de 90 días construido alrededor de tu meta real',
        'Reportes de progreso semanales',
        'Acceso prioritario a tu coach',
      ]}
    />
  </section>
  <p class="billing-note">Todos los planes se facturan mensualmente, cancela cuando quieras · Planes anuales con descuento dentro de la app</p>

  <section class="anchor">
    <div class="container">
      <h2 class="anchor-title">Por qué $49.99 sigue sin ser la opción <span class="clip-talk">cara</span></h2>
      <div class="compare">
        <div class="compare-col">
          <p class="compare-label">Maestro particular, 2×/semana</p>
          <p class="compare-price muted">$200–320<span>/mes</span></p>
          <p class="compare-copy">Con horario fijo, limitado a la disponibilidad de tu maestro, sin corrección fuera de la clase.</p>
        </div>
        <div class="compare-col vocele">
          <p class="compare-label pink">Vocele Meta</p>
          <p class="compare-price"><span class="clip-talk">$49.99</span><span class="per">/mes</span></p>
          <p class="compare-copy light">Práctica diaria, a cualquier hora, más un plan construido alrededor de la conversación que de verdad te importa.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .masthead { padding: 84px 0 56px; border-bottom: var(--border-bold); }
  .mast-title { font-size: clamp(2.75rem, 7vw, 5.25rem); line-height: 0.98; margin: 0 0 var(--space-lg); max-width: 15ch; }
  .lead { color: var(--color-text-secondary); font-size: 1.1875rem; max-width: 56ch; margin: 0; }

  .triptych { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-bottom: var(--border-bold); }

  .billing-note {
    text-align: center; margin: 0; padding: 22px var(--space-lg);
    font-family: var(--font-display); font-weight: 600; font-size: 0.8125rem;
    letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--color-text-secondary); border-bottom: var(--border-bold);
  }

  .anchor { background: var(--color-ink); color: #f5f5f7; padding: 100px 0; }
  .anchor-title { font-size: clamp(2.25rem, 4.5vw, 3.625rem); line-height: 1.02; margin: 0 0 var(--space-2xl); max-width: 22ch; color: #f5f5f7; }
  .compare { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border: 2px solid #f5f5f7; }
  .compare-col { padding: 44px 40px; }
  .compare-col:first-child { border-right: 2px solid #f5f5f7; }
  .compare-col.vocele { background: linear-gradient(160deg, rgba(245,125,158,0.14), rgba(240,69,130,0.08)); }
  .compare-label { font-family: var(--font-display); font-weight: 700; font-size: 0.875rem; letter-spacing: 0.1em; text-transform: uppercase; margin: 0 0 10px; color: var(--color-ink-soft); }
  .compare-label.pink { color: var(--grad-talk-from); }
  .compare-price { font-family: var(--font-display); font-weight: 800; font-size: clamp(2.375rem, 4vw, 3.625rem); line-height: 1; letter-spacing: -0.03em; margin: 0 0 16px; }
  .compare-price.muted { color: var(--color-ink-soft); }
  .compare-price span, .compare-price .per { font-size: 1.0625rem; font-weight: 600; color: var(--color-ink-soft); }
  .compare-copy { font-size: 1rem; line-height: 1.6; margin: 0; color: var(--color-ink-soft); }
  .compare-copy.light { color: #d7d7db; }

  @media (max-width: 820px) {
    .triptych { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .masthead, .anchor { padding-left: 0; padding-right: 0; }
    .anchor { padding: 72px 0; }
    .compare { grid-template-columns: 1fr; }
    .compare-col:first-child { border-right: none; border-bottom: 2px solid #f5f5f7; }
  }
</style>
