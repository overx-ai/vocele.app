---
// Thin wrapper over BaseLayout for blog articles. Looks up the article's meta
// from blog-posts.ts (single source of truth) and emits BlogPosting +
// BreadcrumbList (+ optional FAQPage) JSON-LD. Articles are original per locale:
// a single-locale manifest entry → self-canonical, zero hreflang.
import BaseLayout from './BaseLayout.astro';
import { postBySlug, categoryAccent } from '../blog-posts';
import { useLang } from '../i18n';
import { localePath } from '../site-pages';
import { articleSchema, breadcrumbSchema, faqPageSchema, siteOrigin } from '../site';
import ArticleByline from '../components/ArticleByline.astro';
import ArticleCta from '../components/ArticleCta.astro';
import '../styles/article.css';

export interface Props {
  /** Manifest slug, e.g. 'blog/ai-accent-training'. */
  slug: string;
  /** Optional in-article FAQ — rendered by the page; schema emitted here. */
  faq?: { q: string; a: string }[];
}

const { slug, faq = [] } = Astro.props;
const post = postBySlug(slug);
const lang = post.locale;
const accent = categoryAccent[post.category.gradient];

const site = siteOrigin(Astro.site);
const canonicalURL = `${site}${localePath(lang, slug)}`;
const blogIndexPath = localePath(lang, 'blog');
const homePath = localePath(lang, '');
const { t } = useLang(lang);

const structuredData: object[] = [
  articleSchema({
    type: 'BlogPosting',
    headline: post.title,
    description: post.description,
    datePublished: post.datePublished,
    dateModified: post.dateModified,
    lang,
    url: canonicalURL,
    site,
  }),
  breadcrumbSchema([
    { name: t.nav.home, url: `${site}${homePath}` },
    { name: t.nav.blog, url: `${site}${blogIndexPath}` },
    { name: post.cardTitle, url: canonicalURL },
  ]),
];

if (faq.length > 0) structuredData.push(faqPageSchema(faq));
---
<BaseLayout
  title={post.title}
  description={post.description}
  lang={lang}
  slug={slug}
  structuredData={structuredData}
  ogType="article"
  article={{ published: post.datePublished, modified: post.dateModified ?? post.datePublished }}
>
  <section class="art-masthead">
    <div class="container">
      <nav class="crumbs" aria-label={t.nav.breadcrumbLabel}>
        <a href={homePath}>{t.nav.home}</a>
        <span class="sep" aria-hidden="true">→</span>
        <a href={blogIndexPath}>{t.nav.blog}</a>
        <span class="sep" aria-hidden="true">→</span>
        <span class="crumb-cat" style={`background: var(--gradient-${post.category.gradient})`}>{post.category.label}</span>
      </nav>
      <h1 class="art-title">{post.title}</h1>
      <ArticleByline lang={lang} datePublished={post.datePublished} dateModified={post.dateModified} />
    </div>
  </section>

  <article class="art-body" style={`--prose-accent:${accent}`}>
    <div class="prose">
      <slot />
    </div>
    {faq.length > 0 && (
      <section class="article-faq">
        <h2>{t.article.faqHeading}</h2>
        {faq.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p set:html={f.a} />
          </details>
        ))}
      </section>
    )}
  </article>

  <ArticleCta lang={lang} />
</BaseLayout>

