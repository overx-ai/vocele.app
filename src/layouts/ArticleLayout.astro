---
// Thin wrapper over BaseLayout for blog articles. Looks up the article's meta
// from blog-posts.ts (single source of truth) and emits BlogPosting +
// BreadcrumbList (+ optional FAQPage) JSON-LD. Articles are original per locale:
// translated:false in the manifest → self-canonical, zero hreflang.
import BaseLayout from './BaseLayout.astro';
import { postBySlug, categoryAccent } from '../blog-posts';
import { enPath, esPath } from '../site-pages';

export interface Props {
  /** Manifest slug, e.g. 'blog/ai-accent-training'. */
  slug: string;
  /** Optional in-article FAQ — rendered by the page; schema emitted here. */
  faq?: { q: string; a: string }[];
}

const { slug, faq = [] } = Astro.props;
const post = postBySlug(slug);
const lang = post.locale;
const accent = categoryAccent[post.category.gradient];

const site = Astro.site?.toString().replace(/\/$/, '') ?? 'https://vocele.app';
const path = lang === 'es' ? esPath(slug) : enPath(slug);
const canonicalURL = `${site}${path}`;
const blogIndexPath = lang === 'es' ? '/es/blog' : '/blog';
const homePath = lang === 'es' ? '/es' : '/';

const org = { '@type': 'Organization', name: 'Vocele', url: 'https://vocele.app' };

const structuredData: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.title,
    description: post.description,
    datePublished: post.datePublished,
    inLanguage: lang === 'es' ? 'es-MX' : 'en-US',
    author: org,
    publisher: org,
    mainEntityOfPage: canonicalURL,
    image: `${site}/og-image.jpg`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: lang === 'es' ? 'Inicio' : 'Home', item: `${site}${homePath}` },
      { '@type': 'ListItem', position: 2, name: lang === 'es' ? 'Artículos' : 'Blog', item: `${site}${blogIndexPath}` },
      { '@type': 'ListItem', position: 3, name: post.cardTitle, item: canonicalURL },
    ],
  },
];

if (faq.length > 0) {
  structuredData.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') },
    })),
  });
}

const dateLabel = new Date(post.datePublished + 'T00:00:00Z').toLocaleDateString(
  lang === 'es' ? 'es-MX' : 'en-US',
  { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' },
);
---
<BaseLayout
  title={post.title}
  description={post.description}
  lang={lang}
  slug={slug}
  structuredData={structuredData}
>
  <section class="art-masthead">
    <div class="container">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href={homePath}>{lang === 'es' ? 'Inicio' : 'Home'}</a>
        <span class="sep" aria-hidden="true">→</span>
        <a href={blogIndexPath}>{lang === 'es' ? 'Artículos' : 'Blog'}</a>
        <span class="sep" aria-hidden="true">→</span>
        <span class="crumb-cat" style={`background: var(--gradient-${post.category.gradient})`}>{post.category.label}</span>
      </nav>
      <h1 class="art-title">{post.title}</h1>
      <p class="byline">
        <span class="byline-brand">
          <!-- The byline's copy of the header mark — same asset, same iOS mask. See Header.astro. -->
          <img src="/logo-96.png" width="20" height="20" alt="" class="byline-mark" />
          Vocele
        </span>
        <span class="sep" aria-hidden="true">·</span>
        <time datetime={post.datePublished}>{dateLabel}</time>
      </p>
    </div>
  </section>

  <article class="art-body" style={`--prose-accent:${accent}`}>
    <div class="prose">
      <slot />
    </div>
    {faq.length > 0 && (
      <section class="article-faq">
        <h2>{lang === 'es' ? 'Preguntas frecuentes' : 'Frequently asked questions'}</h2>
        {faq.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p set:html={f.a} />
          </details>
        ))}
      </section>
    )}
  </article>

  <section class="art-cta">
    <div class="container cta-inner">
      <h2>{lang === 'es' ? 'Practica hoy con tu ' : 'Practice today with your '}<span class="clip-talk">{lang === 'es' ? 'coach de IA.' : 'AI coach.'}</span></h2>
      <p>
        {lang === 'es'
          ? 'Vocele corrige tu inglés hablado en tiempo real y entrena tu acento, palabra por palabra.'
          : 'Vocele corrects your spoken sentences in real time and trains your accent, word by word.'}
      </p>
      <a href={homePath} class="pill pill-light">{lang === 'es' ? 'Conoce Vocele' : 'Meet Vocele'} <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---- Masthead ---- */
  .art-masthead { padding: 72px 0 48px; border-bottom: var(--border-bold); }
  .crumbs { display: flex; align-items: center; gap: 10px; margin-bottom: 26px; font-family: var(--font-display); font-weight: 700; font-size: 0.8125rem; letter-spacing: 0.1em; text-transform: uppercase; flex-wrap: wrap; }
  .crumbs a { text-decoration: none; color: var(--color-text-secondary); }
  .crumbs a:hover { color: var(--grad-talk-to); }
  .crumbs .sep { color: var(--color-text-secondary); }
  .crumb-cat { color: #fff; padding: 5px 12px; border-radius: var(--radius-pill); font-size: 0.75rem; }
  .art-title { font-size: clamp(2.25rem, 5vw, 3.875rem); line-height: 1.0; letter-spacing: -0.035em; margin: 0 0 28px; max-width: 22ch; }
  .byline { display: flex; align-items: center; gap: 14px; font-family: var(--font-display); font-weight: 600; font-size: 0.84375rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-text-secondary); margin: 0; }
  .byline-brand { display: inline-flex; align-items: center; gap: 8px; }
  /* 22.4% is the iOS icon mask — see Header.astro's `.logo-mark`. */
  .byline-mark { display: block; border-radius: 22.4%; flex: none; }

  /* ---- Article body (centered prose column) ---- */
  .art-body { max-width: var(--max-width-prose); margin: 0 auto; padding: 64px var(--space-lg) 40px; }
  .prose { counter-reset: h2; }
  .prose :global(p) { font-size: 1.0625rem; line-height: 1.7; color: var(--color-text-muted); margin: 0 0 18px; }
  .prose :global(p:first-child) { font-size: 1.3125rem; line-height: 1.65; color: var(--color-text); margin-bottom: 22px; }
  .prose :global(strong) { color: var(--color-ink); }
  .prose :global(em) { font-style: italic; }
  .prose :global(a) { color: var(--grad-talk-to); text-decoration: none; border-bottom: 2px solid var(--grad-talk-to); }

  .prose :global(h2) {
    counter-increment: h2;
    font-family: var(--font-display); font-weight: 800; font-size: 1.875rem; line-height: 1.1;
    letter-spacing: -0.02em; text-transform: uppercase;
    border-top: var(--border-bold); padding-top: 26px; margin: 44px 0 20px;
  }
  .prose :global(h2)::before {
    content: counter(h2, decimal-leading-zero) "  ";
    color: var(--prose-accent, var(--grad-talk-to));
    font-size: 0.9375rem;
  }

  .prose :global(ul) { list-style: none; padding: 0; margin: 0 0 18px; display: flex; flex-direction: column; gap: 14px; }
  .prose :global(ul li) { position: relative; padding-left: 28px; font-size: 1.0625rem; line-height: 1.7; color: var(--color-text-muted); }
  .prose :global(ul li)::before { content: "→"; position: absolute; left: 0; color: var(--prose-accent, var(--grad-talk-to)); font-family: var(--font-display); font-weight: 800; }

  .prose :global(table) { border-collapse: collapse; width: 100%; margin: 0 0 24px; font-size: 0.96875rem; }
  .prose :global(th), .prose :global(td) { border: var(--border-bold); padding: 12px 16px; text-align: left; }
  .prose :global(th) { background: var(--color-ink); color: #fff; font-family: var(--font-display); font-weight: 700; font-size: 0.8125rem; letter-spacing: 0.08em; text-transform: uppercase; }

  .prose :global(figure) { margin: 0 0 28px; border: var(--border-bold); box-shadow: 8px 8px 0 var(--prose-accent, var(--grad-talk-to)); padding: 26px 28px; }
  .prose :global(figcaption) { font-family: var(--font-display); font-weight: 800; font-size: 0.75rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--prose-accent, var(--grad-talk-to)); margin-bottom: 14px; }

  /* ---- In-article FAQ ---- */
  .article-faq { margin-top: var(--space-2xl); }
  .article-faq h2 { font-family: var(--font-display); font-weight: 800; font-size: 2.125rem; line-height: 1.05; letter-spacing: -0.02em; text-transform: uppercase; border-top: var(--border-bold); padding-top: 30px; margin: 0 0 8px; }
  .article-faq details { border-bottom: var(--border-bold); padding: 20px 0; }
  .article-faq summary { font-family: var(--font-display); font-weight: 700; font-size: 1.125rem; cursor: pointer; }
  .article-faq p { color: var(--color-text-muted); margin-top: 14px; line-height: 1.7; }

  /* ---- CTA ---- */
  .art-cta { background: var(--color-ink); color: #f5f5f7; padding: 84px 0; }
  .cta-inner { max-width: var(--max-width-prose); margin: 0 auto; text-align: center; }
  .cta-inner h2 { font-size: clamp(2rem, 3.5vw, 2.875rem); line-height: 1.02; margin: 0 0 16px; color: #f5f5f7; }
  .cta-inner p { color: var(--color-ink-soft); font-size: 1.0625rem; margin: 0 0 30px; }

  @media (max-width: 640px) {
    .art-masthead { padding: 56px 0 40px; }
    .art-body { padding: 44px var(--space-lg) 32px; }
    .art-cta { padding: 64px 0; }
  }
</style>
