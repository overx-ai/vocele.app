---
// Thin wrapper over BaseLayout for blog articles. Looks up the article's meta
// from blog-posts.ts (single source of truth) and emits BlogPosting +
// BreadcrumbList (+ optional FAQPage) JSON-LD. Articles are original per locale:
// translated:false in the manifest → self-canonical, zero hreflang.
import BaseLayout from './BaseLayout.astro';
import { postBySlug, categoryAccent } from '../blog-posts';
import { enPath, esPath } from '../site-pages';
import { ORG, AUTHOR } from '../site';
import '../styles/article.css';

export interface Props {
  /** Manifest slug, e.g. 'blog/ai-accent-training'. */
  slug: string;
  /** Optional in-article FAQ — rendered by the page; schema emitted here. */
  faq?: { q: string; a: string }[];
}

const { slug, faq = [] } = Astro.props;
const post = postBySlug(slug);
const lang = post.locale;
const accent = categoryAccent[post.category.gradient];

const site = Astro.site?.toString().replace(/\/$/, '') ?? 'https://vocele.app';
const path = lang === 'es' ? esPath(slug) : enPath(slug);
const canonicalURL = `${site}${path}`;
const blogIndexPath = lang === 'es' ? '/es/blog' : '/blog';
const homePath = lang === 'es' ? '/es' : '/';


const structuredData: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.title,
    description: post.description,
    datePublished: post.datePublished,
    dateModified: post.dateModified ?? post.datePublished,
    inLanguage: lang === 'es' ? 'es-MX' : 'en-US',
    author: AUTHOR,
    publisher: ORG,
    mainEntityOfPage: canonicalURL,
    image: `${site}/og-image.jpg`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: lang === 'es' ? 'Inicio' : 'Home', item: `${site}${homePath}` },
      { '@type': 'ListItem', position: 2, name: lang === 'es' ? 'Artículos' : 'Blog', item: `${site}${blogIndexPath}` },
      { '@type': 'ListItem', position: 3, name: post.cardTitle, item: canonicalURL },
    ],
  },
];

if (faq.length > 0) {
  structuredData.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') },
    })),
  });
}

const fmt = (iso: string) =>
  new Date(iso + 'T00:00:00Z').toLocaleDateString(lang === 'es' ? 'es-MX' : 'en-US', {
    year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC',
  });
const dateLabel = fmt(post.datePublished);
const modified = post.dateModified && post.dateModified !== post.datePublished ? post.dateModified : undefined;
---
<BaseLayout
  title={post.title}
  description={post.description}
  lang={lang}
  slug={slug}
  structuredData={structuredData}
  ogType="article"
  article={{ published: post.datePublished, modified: post.dateModified ?? post.datePublished }}
>
  <section class="art-masthead">
    <div class="container">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href={homePath}>{lang === 'es' ? 'Inicio' : 'Home'}</a>
        <span class="sep" aria-hidden="true">→</span>
        <a href={blogIndexPath}>{lang === 'es' ? 'Artículos' : 'Blog'}</a>
        <span class="sep" aria-hidden="true">→</span>
        <span class="crumb-cat" style={`background: var(--gradient-${post.category.gradient})`}>{post.category.label}</span>
      </nav>
      <h1 class="art-title">{post.title}</h1>
      <p class="byline">
        <span class="byline-brand">
          <!-- The byline's copy of the header mark — same asset, same iOS mask. See Header.astro. -->
          <img src="/logo-96.png" width="20" height="20" alt="" class="byline-mark" />
          {AUTHOR.name}, {lang === 'es' ? 'fundador de' : 'founder of'} <a href={lang === 'es' ? '/es' : '/'} rel="author">Vocele</a>
        </span>
        <span class="sep" aria-hidden="true">·</span>
        <time datetime={post.datePublished}>{dateLabel}</time>
        {modified && (
          <>
            <span class="sep" aria-hidden="true">·</span>
            <span>{lang === 'es' ? 'Actualizado' : 'Updated'} <time datetime={modified}>{fmt(modified)}</time></span>
          </>
        )}
      </p>
    </div>
  </section>

  <article class="art-body" style={`--prose-accent:${accent}`}>
    <div class="prose">
      <slot />
    </div>
    {faq.length > 0 && (
      <section class="article-faq">
        <h2>{lang === 'es' ? 'Preguntas frecuentes' : 'Frequently asked questions'}</h2>
        {faq.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p set:html={f.a} />
          </details>
        ))}
      </section>
    )}
  </article>

  <section class="art-cta">
    <div class="container cta-inner">
      <h2>{lang === 'es' ? 'Practica hoy con tu ' : 'Practice today with your '}<span class="clip-talk">{lang === 'es' ? 'coach de IA.' : 'AI coach.'}</span></h2>
      <p>
        {lang === 'es'
          ? 'Vocele corrige tu inglés hablado en tiempo real y entrena tu acento, palabra por palabra.'
          : 'Vocele corrects your spoken sentences in real time and trains your accent, word by word.'}
      </p>
      <a href={homePath} class="pill pill-light">{lang === 'es' ? 'Conoce Vocele' : 'Meet Vocele'} <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</BaseLayout>

