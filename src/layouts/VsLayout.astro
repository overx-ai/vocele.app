---
// Thin wrapper for /vs/<competitor> pages. Reads meta from vs-pages.ts and emits
// Article + BreadcrumbList + FAQPage — never AggregateRating or Review (we have
// no third-party ratings to back one).
import BaseLayout from './BaseLayout.astro';
import { vsBySlug } from '../vs-pages';
import { articleSchema } from '../site';
import ArticleByline from '../components/ArticleByline.astro';
import ArticleCta from '../components/ArticleCta.astro';
import '../styles/article.css';

export interface Props {
  slug: string;
}

const { slug } = Astro.props;
const page = vsBySlug(slug);
const site = Astro.site?.toString().replace(/\/$/, '') ?? 'https://vocele.app';
const canonicalURL = `${site}/vs/${slug}`;

const structuredData: object[] = [
  articleSchema({
    type: 'Article',
    headline: page.title,
    description: page.description,
    datePublished: page.datePublished,
    dateModified: page.dateModified,
    lang: 'en',
    url: canonicalURL,
    site,
  }),
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site}/` },
      { '@type': 'ListItem', position: 2, name: `Vocele vs ${page.competitor}`, item: canonicalURL },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: page.faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') },
    })),
  },
];
---
<BaseLayout
  title={page.title}
  description={page.description}
  slug={`vs/${slug}`}
  structuredData={structuredData}
  ogType="article"
  article={{ published: page.datePublished, modified: page.dateModified ?? page.datePublished }}
>
  <section class="art-masthead">
    <div class="container">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="sep" aria-hidden="true">→</span>
        <span class="crumb-cat" style="background: var(--gradient-talk)">Compare</span>
      </nav>
      <h1 class="art-title">{page.title}</h1>
      <ArticleByline lang="en" datePublished={page.datePublished} dateModified={page.dateModified} />
    </div>
  </section>

  <article class="art-body" style="--prose-accent:#f04582">
    <div class="prose">
      <slot />
    </div>
    <section class="article-faq">
      <h2>Frequently asked questions</h2>
      {page.faq.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p set:html={f.a} />
        </details>
      ))}
    </section>
  </article>

  <ArticleCta lang="en" />
</BaseLayout>
