---
// Shared SEO shell for every page. All content below is rendered to plain, static
// HTML at build time — there is no client-side rendering step a crawler has to wait
// for, no hydration mismatch risk, nothing behind JavaScript.
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { hasTranslation, enPath as buildEnPath, esPath as buildEsPath } from '../site-pages';
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  lang?: 'en' | 'es';
  /** Path segment shared by the en/es equivalents, e.g. "" for home, "pricing", "faq". Used to build hreflang + canonical. */
  slug?: string;
  ogImage?: string;
  structuredData?: object[];
  noindex?: boolean;
}

const {
  title,
  description,
  lang = 'en',
  slug = '',
  ogImage = '/og-image.jpg',
  structuredData = [],
  noindex = false,
} = Astro.props;

const site = Astro.site?.toString().replace(/\/$/, '') ?? 'https://vocele.app';
const enPath = buildEnPath(slug);
const esPath = buildEsPath(slug);
const currentPath = lang === 'es' ? esPath : enPath;
const canonicalURL = `${site}${currentPath}`;
const fullTitle = title.includes('Vocele') ? title : `${title} | Vocele`;

// noindex pages (404) get no canonical/hreflang. Single-locale pages (privacy,
// terms) get a canonical but no hreflang — its /es twin doesn't exist.
const indexable = !noindex;
const translated = indexable && hasTranslation(slug);

// WebSite schema (Google site-name) on the home pages only, per Google guidance.
// No page defines its own WebSite entry today — keep it that way.
const websiteSchema =
  slug === '' && indexable
    ? [{
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: 'Vocele',
        url: `${site}/`,
        inLanguage: lang === 'es' ? 'es-MX' : 'en-US',
      }]
    : [];
const allStructuredData = [...websiteSchema, ...structuredData];
---

<!DOCTYPE html>
<html lang={lang === 'es' ? 'es-MX' : 'en-US'}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  {import.meta.env.PROD && (
    <>
      {/* Google Analytics (GA4). Prod builds only; excluded from `astro dev`. */}
      <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-0ZQBJJGWPG"></script>
      <script is:inline>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'G-0ZQBJJGWPG');
      </script>
    </>
  )}

  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  {noindex
    ? <meta name="robots" content="noindex, nofollow" />
    : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />}

  {indexable && <link rel="canonical" href={canonicalURL} />}
  {translated && (
    <>
      <link rel="alternate" hreflang="en-US" href={`${site}${enPath}`} />
      <link rel="alternate" hreflang="es-MX" href={`${site}${esPath}`} />
      <link rel="alternate" hreflang="x-default" href={`${site}${enPath}`} />
    </>
  )}

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Vocele" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:image" content={`${site}${ogImage}`} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="675" />
  <meta property="og:image:alt" content="Vocele — AI Language Coach" />
  <meta property="og:locale" content={lang === 'es' ? 'es_MX' : 'en_US'} />
  {translated && <meta property="og:locale:alternate" content={lang === 'es' ? 'en_US' : 'es_MX'} />}

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={`${site}${ogImage}`} />

  <!--
    The app icon, as raster. It is a photographic chrome render (iridescent liquid metal on a
    near-black field), so there is no honest SVG of it — and the retired favicon.svg was a flat
    pink smile mark. That retirement is load-bearing: an `image/svg+xml` icon WINS over PNG in
    every browser that supports it, so leaving that one line here would have kept serving the old
    logo no matter what else we shipped.
    16/32 are a 12% centre crop — at tab size the full frame's dark margin eats the eyes.
  -->
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
  <link rel="icon" type="image/png" href="/favicon-16.png" sizes="16x16" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#F04582" />
  <meta name="color-scheme" content="light" />
  <!-- Outfit display face — self-hosted latin subset, one same-origin request. -->
  <link rel="preload" href="/fonts/outfit-latin.woff2" as="font" type="font/woff2" crossorigin />

  {allStructuredData.map((entry) => (
    <script type="application/ld+json" set:html={JSON.stringify(entry)} />
  ))}
</head>
<body>
  <a href="#main" class="skip-link">Skip to content</a>
  <Header lang={lang} slug={slug} translated={translated} />
  <main id="main">
    <slot />
  </main>
  <Footer lang={lang} />
</body>
</html>
