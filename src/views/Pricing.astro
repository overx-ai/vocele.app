---
import BaseLayout from '../layouts/BaseLayout.astro';
import PricingCard from '../components/PricingCard.astro';
import Clip from '../components/Clip.astro';
import { useLang } from '../i18n';
import { PLANS, PLAN_NAMES, PRICES, TUTOR } from '../data/prices';
import { ORG, breadcrumbSchema, jsonLd, softwareApp } from '../site';
import { downloadPath, localePath } from '../site-pages';
import type { Lang } from '../data/types';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { t } = useLang(lang);
const p = t.pricing;
const { display } = PRICES[lang];

const structuredData = [
  jsonLd(softwareApp(lang)),
  breadcrumbSchema([
    { name: t.nav.home, url: `${ORG.url}${localePath(lang, '')}` },
    { name: t.nav.pricing, url: `${ORG.url}${localePath(lang, 'pricing')}` },
  ]),
];
---
<BaseLayout title={p.meta.title} description={p.meta.description} lang={lang} slug="pricing" structuredData={structuredData}>
  <section class="masthead">
    <div class="container">
      <span class="eyebrow">{p.eyebrow}</span>
      <h1 class="mast-title"><Clip parts={p.title} /></h1>
      <p class="lead">{p.lead}</p>
    </div>
  </section>

  <section class="triptych">
    {PLANS.map((plan) => (
      <PricingCard
        variant={plan}
        badge={plan === 'fluency' ? p.popular : undefined}
        name={PLAN_NAMES[plan]}
        price={display[plan]}
        period={p.period}
        tagline={p.plans[plan].tagline}
        cta={p.plans[plan].cta}
        ctaHref={downloadPath(lang)}
        features={p.plans[plan].features}
      />
    ))}
  </section>
  {p.notes.map((note) => <p class="billing-note" set:html={note} />)}

  <section class="anchor">
    <div class="container">
      <h2 class="anchor-title"><Clip parts={p.anchorTitle} class="clip-talk" /></h2>
      {p.compareLinks && <p class="anchor-links" set:html={p.compareLinks} />}
      <div class="compare">
        <div class="compare-col">
          <p class="compare-label">{p.tutor.label}</p>
          <p class="compare-price muted">{TUTOR[lang].tutorRange}<span class="per">{p.perMonth}</span></p>
          <p class="compare-copy">{p.tutor.copy}</p>
        </div>
        <div class="compare-col vocele">
          <p class="compare-label pink">{p.vocele.label}</p>
          <p class="compare-price"><span class="clip-talk">{display.meta}</span><span class="per">{p.perMonth}</span></p>
          <p class="compare-copy light">{p.vocele.copy}</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .masthead { padding: 84px 0 56px; border-bottom: var(--border-bold); }
  .mast-title { font-size: clamp(2.75rem, 7vw, 5.25rem); line-height: 0.98; margin: 0 0 var(--space-lg); max-width: 15ch; }
  .lead { color: var(--color-text-secondary); font-size: 1.1875rem; max-width: 56ch; margin: 0; }

  .triptych { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-bottom: var(--border-bold); }

  .billing-note {
    text-align: center; margin: 0; padding: 22px var(--space-lg);
    font-family: var(--font-display); font-weight: 600; font-size: 0.8125rem;
    letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--color-text-secondary); border-bottom: var(--border-bold);
  }

  .anchor { background: var(--color-ink); color: #f5f5f7; padding: 100px 0; }
  .anchor-title { font-size: clamp(2.25rem, 4.5vw, 3.625rem); line-height: 1.02; margin: 0 0 var(--space-2xl); max-width: 22ch; color: #f5f5f7; }
  .anchor-links { color: var(--color-ink-soft); margin: -28px 0 28px; font-size: 1rem; }
  .anchor-links :global(a) { color: #f5f5f7; border-bottom: 2px solid var(--grad-talk-to); text-decoration: none; }
  .compare { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border: 2px solid #f5f5f7; }
  .compare-col { padding: 44px 40px; }
  .compare-col:first-child { border-inline-end: 2px solid #f5f5f7; }
  .compare-col.vocele { background: linear-gradient(160deg, rgba(245,125,158,0.14), rgba(240,69,130,0.08)); }
  .compare-label { font-family: var(--font-display); font-weight: 700; font-size: 0.875rem; letter-spacing: 0.1em; text-transform: uppercase; margin: 0 0 10px; color: var(--color-ink-soft); }
  .compare-label.pink { color: var(--grad-talk-from); }
  .compare-price { font-family: var(--font-display); font-weight: 800; font-size: clamp(2.375rem, 4vw, 3.625rem); line-height: 1; letter-spacing: -0.03em; margin: 0 0 16px; }
  .compare-price.muted { color: var(--color-ink-soft); }
  .compare-price .per { font-size: 1.0625rem; font-weight: 600; color: var(--color-ink-soft); }
  .compare-copy { font-size: 1rem; line-height: 1.6; margin: 0; color: var(--color-ink-soft); }
  .compare-copy.light { color: #d7d7db; }

  @media (max-width: 820px) {
    .triptych { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .masthead, .anchor { padding-inline: 0; }
    .anchor { padding: 72px 0; }
    .compare { grid-template-columns: 1fr; }
    .compare-col:first-child { border-inline-end: none; border-bottom: 2px solid #f5f5f7; }
  }
</style>
