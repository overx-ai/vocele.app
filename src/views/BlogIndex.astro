---
import BaseLayout from '../layouts/BaseLayout.astro';
import Clip from '../components/Clip.astro';
import { useLang } from '../i18n';
import { postsFor, categoryAccent } from '../blog-posts';
import { localePath } from '../site-pages';
import type { Lang } from '../data/types';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { t, fmt } = useLang(lang);
const b = t.blog;
const posts = postsFor(lang);
const date = (iso: string) => fmt.date(iso, { month: 'short', day: 'numeric', year: 'numeric' });
---
<BaseLayout title={b.meta.title} description={b.meta.description} lang={lang} slug="blog" noindex={posts.length === 0}>
  <section class="masthead">
    <div class="container">
      <span class="eyebrow">{b.eyebrow}</span>
      <h1 class="mast-title"><Clip parts={b.title} /></h1>
      <p class="lead">{b.lead}</p>
    </div>
  </section>

  <section class="post-list">
    <div class="container">
      {posts.length === 0 && <p class="lead empty">{b.empty}</p>}
      {posts.map((post, i) => (
        <a class="post-row" href={localePath(lang, post.slug)} style={`--sh:${categoryAccent[post.category.gradient]}`}>
          <span class="row-n">{String(i + 1).padStart(2, '0')}</span>
          <span class="row-cat"><span class="cat-pill" style={`background: var(--gradient-${post.category.gradient})`}>{post.category.label}</span></span>
          <span class="row-main">
            <span class="row-title">{post.title}</span>
            <span class="row-desc">{post.description}</span>
          </span>
          <time class="row-date" datetime={post.datePublished}>{date(post.datePublished)}</time>
          <span class="row-arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </section>

  <section class="blog-cta">
    <div class="container cta-inner">
      <h2><Clip parts={b.ctaTitle} class="clip-talk" /></h2>
      <a href={localePath(lang, '')} class="pill pill-light">{t.meetVocele} <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</BaseLayout>

<style>
  .masthead { padding: 84px 0 56px; border-bottom: var(--border-bold); }
  .mast-title { font-size: clamp(2.75rem, 7vw, 5.25rem); line-height: 0.98; margin: 0 0 var(--space-lg); max-width: 14ch; }
  .lead { color: var(--color-text-secondary); font-size: 1.1875rem; max-width: 52ch; margin: 0; }

  .post-list { padding: 0 0 90px; }
  .empty { padding-top: 56px; }
  .post-row {
    display: grid;
    grid-template-columns: 90px 200px 1fr 130px 40px;
    gap: 28px;
    align-items: center;
    padding: 40px 8px;
    text-decoration: none;
    color: var(--color-ink);
    border-bottom: var(--border-bold);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .post-row:hover { transform: translate(calc(-5px * var(--flip)), -5px); box-shadow: calc(8px * var(--flip)) 8px 0 var(--sh); color: var(--color-ink); }
  .row-n { font-family: var(--font-display); font-weight: 800; font-size: 1.0625rem; color: var(--color-text-secondary); }
  .cat-pill { font-family: var(--font-display); font-weight: 700; font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase; color: #fff; padding: 5px 12px; border-radius: var(--radius-pill); display: inline-block; }
  .row-title { display: block; font-family: var(--font-display); font-weight: 800; font-size: 1.875rem; line-height: 1.05; letter-spacing: -0.02em; text-transform: uppercase; margin-bottom: 10px; }
  .row-desc { display: block; font-size: 0.96875rem; color: var(--color-text-secondary); line-height: 1.55; max-width: 66ch; }
  .row-date { font-family: var(--font-display); font-weight: 600; font-size: 0.8125rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-text-secondary); }
  .row-arrow { font-size: 1.625rem; font-weight: 700; }

  .blog-cta { background: var(--color-ink); color: #f5f5f7; padding: 84px 0; }
  .cta-inner { display: flex; align-items: center; justify-content: space-between; gap: 40px; flex-wrap: wrap; }
  .cta-inner h2 { font-size: clamp(2rem, 3.5vw, 2.875rem); line-height: 1.02; margin: 0; max-width: 22ch; color: #f5f5f7; }

  @media (max-width: 860px) {
    .post-row { grid-template-columns: auto 1fr auto; gap: var(--space-md); padding: 28px 4px; }
    .row-n { display: none; }
    .row-main { grid-column: 1 / -1; order: 3; }
    .row-date { order: 2; text-align: end; }
    .row-arrow { display: none; }
    .post-row:hover { transform: none; box-shadow: none; }
  }
  @media (max-width: 640px) {
    .row-title { font-size: 1.375rem; }
    .blog-cta { padding: 64px 0; }
  }
</style>
